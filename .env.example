# IPTV Proxy v2 Environment Configuration
# Copy this file to .env and customize for your setup

# =============================================================================
# Core Settings
# =============================================================================

# Port to run the application (default: 8000)
PORT=8000

# Enable debug mode (default: False)
DEBUG=False

# Background scheduler runs in a separate process (set by entrypoint.sh).
# Set DISABLE_SCHEDULER=true to disable all background sync.
# DISABLE_SCHEDULER=false

# Max parallel EPG source sync workers in scheduler / manual sync (default: 3)
# EPG_SYNC_PARALLEL_WORKERS=3

# Clear stale EPG sync_in_progress locks older than this many hours on startup (default: 12)
# EPG_SYNC_STALE_LOCK_HOURS=12

# Scheduled data retention (see docs/DEVELOPER_GUIDE.md — Database lifecycle)
# EVENT_RETENTION_DAYS=90

# User/Group IDs for file permissions (default: 1000)
PUID=1000
PGID=1000

# =============================================================================
# Database
# =============================================================================

# SQLite (default)
DATABASE_URL=sqlite:////app/data/iptv_proxy.db

# PostgreSQL (docker compose --profile postgres, or klopstack shared postgresql service)
# DATABASE_URL=postgresql://iptv:changeme@localhost:5432/iptv_proxy
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# Docker Compose postgres profile (optional local PostgreSQL container)
# POSTGRES_DB=iptv_proxy
# POSTGRES_USER=iptv
# POSTGRES_PASSWORD=changeme

# =============================================================================
# Stream Backend Configuration
# =============================================================================

# Stream backend: "ffmpeg" (default) or "mediaflow"
#
# ffmpeg: Uses FFmpeg subprocess for MPEG-TS remuxing
#   - Pros: No external dependencies, handles timestamp issues
#   - Cons: Higher CPU usage, occasional timestamp jumps
#
# mediaflow: Uses MediaFlow Proxy for HLS/TS proxying
#   - Pros: Pre-buffering reduces stuttering, memory-managed caching
#   - Cons: Requires running mediaflow-proxy container
#
STREAM_BACKEND=ffmpeg

# Seconds before an ActiveStream row with no heartbeat is reaped as stale.
# Active streams emit a heartbeat while data flows, so this only reaps genuinely
# abandoned rows. Default is generous to avoid reaping live sessions.
STREAM_TIMEOUT_SECONDS=300

# Seconds a shared upstream stays open after its last subscriber leaves.
# Default 0 closes immediately on a channel zap so the credential slot frees
# right away. Raise it only if you want a brief reconnect grace period.
STREAM_IDLE_TIMEOUT=0

# =============================================================================
# MediaFlow Proxy Settings (only used when STREAM_BACKEND=mediaflow)
# =============================================================================

# URL of MediaFlow Proxy service
MEDIAFLOW_PROXY_URL=http://localhost:8888

# API password for MediaFlow Proxy (optional but recommended)
# Must match the API_PASSWORD in the mediaflow-proxy container
MEDIAFLOW_API_PASSWORD=

# =============================================================================
# MediaFlow Pre-buffering (configured in docker-compose.yml)
# =============================================================================
# These are set in docker-compose.yml but documented here for reference:
#
# ENABLE_HLS_PREBUFFER=true      # Enable HLS segment pre-buffering
# HLS_PREBUFFER_SEGMENTS=5       # Number of segments to buffer ahead
# HLS_PREBUFFER_CACHE_SIZE=50    # Max segments in memory cache
# HLS_PREBUFFER_MAX_MEMORY_PERCENT=80  # Max memory usage percentage
